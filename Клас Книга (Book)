public class Book {
    private String title;
    private Author author;
    private String isbn;
    private int year;

    public Book() {
    }

    public Book(String title, Author author, String isbn, int year) {
        this.title = title;
        this.author = author;
        this.isbn = isbn;
        this.year = year;
    }

    public void open() {
    }

    public void close() {
    }

    @Override
    public String toString() {
        return "Book{" +
                "title='" + title + '\'' +
                ", author=" + author +
                ", isbn='" + isbn + '\'' +
                ", year=" + year +
                '}';
    }
}
